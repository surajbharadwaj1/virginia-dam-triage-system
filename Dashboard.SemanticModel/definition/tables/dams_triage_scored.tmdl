table dams_triage_scored
	lineageTag: 74bbcbea-6e8d-4487-80cc-2a06c6cbb781

	measure 'Total Dams' = COUNTROWS(dams_triage_scored)
		formatString: 0
		lineageTag: 17f63650-55c2-4a20-9969-d9810894b584

	measure 'Critical Dams' = COUNTROWS(FILTER(dams_triage_scored, [Priority_Band] = "Critical"))
		formatString: 0
		lineageTag: cbdadc95-7109-4abe-8ffc-91825b10fc46

	measure 'No EAP Critical' = COUNTROWS(FILTER(dams_triage_scored, [Priority_Band] = "Critical" && [EAP Prepared] = "No"))
		formatString: 0
		lineageTag: 8b20e10f-9c4f-4c33-a669-b96735c5d563

	measure 'Unclassified Dams' = SUM(dams_triage_scored[Needs_Hazard_Classification])
		formatString: 0
		lineageTag: 37e01464-f1a8-4005-88d4-2f2c2f7dc7a3

