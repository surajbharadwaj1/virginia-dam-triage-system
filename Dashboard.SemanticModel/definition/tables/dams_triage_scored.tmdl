		dataType: string
		lineageTag: 0ad0aa78-d067-4f30-a800-5d7d850a8c0f
		summarizeBy: none
		sourceColumn: Priority_Band

		annotation SummarizationSetBy = Automatic

	column 'Flood Risk' =
			IF([In Fathom 100yr Flood Zone] = 1, "100yr Zone",
			             IF([In Fathom 500yr Flood Zone] = 1, "500yr Zone", "No Flood Zone"))
		lineageTag: 80b56776-9330-4783-ba35-3766032f339b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Inspection Status' = IF(ISBLANK([Inspection_Date_Final]), "Never Inspected", "Inspected")
		lineageTag: cbe37efa-7117-45a7-8518-26453515af0f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'EAP Risk' =
			IF([EAP Prepared] = "No", "No EAP - High Risk",
			           IF([EAP Prepared] = "Yes", "EAP Exists", "Not Required"))
		lineageTag: 77891e92-3c66-4157-8d32-0e37505cde40
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Band Color' =
			SWITCH([Priority_Band],
			    "Critical", "#C62828",
			    "High",     "#E65100",
			    "Moderate", "#F9A825",
			    "Low",      "#2E7D32",
			    "#999999")
		lineageTag: 03bcddc3-8abc-4b8a-aa38-27468bf7ca3e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Flood_Band =
			
			SWITCH(TRUE(),
			    'dams_triage_scored'[D2_Flood_Score] <= 20, "0-20",
			    'dams_triage_scored'[D2_Flood_Score] <= 40, "21-40",
			    'dams_triage_scored'[D2_Flood_Score] <= 60, "41-60",
			    'dams_triage_scored'[D2_Flood_Score] <= 80, "61-80",
			    "81-100"
			)
		lineageTag: de8a68bc-859b-432d-bc19-8e26d7ea1afe
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Map_Category =
			
			IF(
			    'dams_triage_scored'[Inspection_Date_Final] = "Never Inspected",
			    "Not Inspected",
			    'dams_triage_scored'[Priority_Band]
			)
		lineageTag: e3d899be-c3e1-4bf5-913c-b552b1cabd05
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Inspection_Status =
			
			IF(
			    'dams_triage_scored'[Inspection_Date_Final] = "Never Inspected"
			    || ISBLANK('dams_triage_scored'[Inspection_Date_Final])
			    || 'dams_triage_scored'[Inspection_Date_Final] = ""
			    || 'dams_triage_scored'[Inspection_Date_Final] = "Unknown",
			    "Not Inspected",
